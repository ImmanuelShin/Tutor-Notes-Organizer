{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and auxiliary windows",
  "windows": ["main", "aux-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "opener:default",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load"
  ]
}
